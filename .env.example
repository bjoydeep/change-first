# ── GitHub ───────────────────────────────────────────────────────────────
# Webhook secret — must match what you set in GitHub webhook settings
GITHUB_WEBHOOK_SECRET=replace-me

# PAT with pull_requests:read and issues:write (or full repo scope)
GITHUB_TOKEN=ghp_replace-me

# ── AI Model ─────────────────────────────────────────────────────────────
# OpenAI-compatible base URL (no trailing slash)
OPENAI_BASE_URL=https://your-model-endpoint.example.com/v1

# API key for the model endpoint
OPENAI_API_KEY=replace-me

# Model name as the endpoint expects it
MODEL_NAME=gpt-4o

# Max agent loop turns before forced stop
AGENT_MAX_TURNS=10

# ── Skills ────────────────────────────────────────────────────────────────
# "all" loads every registered skill; or comma-separated function names:
# check_pr_description,check_diff_size,check_draft_targeting_protected_branch
ENABLED_SKILLS=all

# ── Server ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
